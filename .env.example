# Server
PORT=8080
PUBLIC_BASE_URL=https://your-public-host.example.com   # used for the WebSub callback

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/bloomscroll

# YouTube Data API v3 (single project — never split across projects)
YOUTUBE_API_KEY=your_api_key

# WebSub
WEBSUB_SECRET=change_me_to_a_long_random_string

# Google OAuth (Phase: per-account user channels — safe to leave blank for MVP)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
