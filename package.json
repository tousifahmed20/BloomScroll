{
  "name": "bloomscroll-backend",
  "version": "0.1.0",
  "description": "BloomScroll — a themed, curated educational Shorts + long-form feed. The anti-doomscroll. Backend: ingestion, WebSub freshness, and the app-facing API.",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "ingest": "tsx src/scripts/onboard.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.4.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": { "node": ">=18" }
}
